    <changeSet id="20250215-05-create-cost-supply" author="d.palomino">
        <createTable tableName="supply">
            <column name="supply_id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="uuid" type="CHAR(38)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="concept_id" type="INT">
            </column>

            <column name="supply_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="unit_acquisition" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="unit_consumption" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="equivalence" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="supply"
                baseColumnNames="concept_id"
                constraintName="fk_cost_supply_concept"
                referencedTableName="concept"
                referencedColumnNames="concept_id"/>
    </changeSet>

    <changeSet id="20250215-06-create-cost-procedure-supply" author="d.palomino">

        <createTable tableName="supply_cost">

            <column name="supply_cost_id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="uuid" type="CHAR(38)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="supply_id" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="cost_structure_id" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="acquisition_price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>

            <column name="unit_cost" type="DECIMAL(10,4)">
                <constraints nullable="false"/>
            </column>

            <column name="quantity_used" type="DECIMAL(10,4)"/>
            <column name="time_minutes" type="DECIMAL(10,4)"/>
            <column name="partial_cost" type="DECIMAL(10,4)">
                <constraints nullable="false"/>
            </column>


        </createTable>

        <!-- FK SupplyCost → Supply -->
        <addForeignKeyConstraint
                baseTableName="supply_cost"
                baseColumnNames="supply_id"
                constraintName="fk_supply_cost"
                referencedTableName="supply"
                referencedColumnNames="supply_id"/>

        <!-- FK SupplyCost → CostStructure -->
        <addForeignKeyConstraint
                baseTableName="supply_cost"
                baseColumnNames="cost_structure_id"
                constraintName="fk_cps_coststructure"
                referencedTableName="cost_structure"
                referencedColumnNames="cost_structure_id"/>

    </changeSet>


</databaseChangeLog>