 	<!-- Uncomment the changeset below if you want to make the Item class persistable, see also Item and CoststructureDaoTest -->
    <changeSet id="2025-01-create-cost-structure" author="d.palomino">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="cost_structure"/>
            </not>
        </preConditions>
        <createTable tableName="cost_structure">
            <column name="cost_structure_id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_date" type="date"/>
            <column name="start_date" type="date"/>
            <column name="end_date" type="date"/>
        </createTable>
    </changeSet>

    <!-- ====================== ANNUAL SERVICE COST ====================== -->
    <changeSet id="2025-02-create-annual-service-cost" author="d.palomino">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="annual_service_cost"/>
            </not>
        </preConditions>
        <createTable tableName="annual_service_cost">
            <column name="annual_service_cost_id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="general_admin_annual_cost" type="decimal(10,2)"/>
            <column name="general_service_annual_cost" type="decimal(10,2)"/>
            <column name="energy_annual_cost" type="decimal(10,2)"/>
            <column name="water_annual_cost" type="decimal(10,2)"/>
            <column name="phonenet_annual_cost" type="decimal(10,2)"/>
            <column name="cost_structure_id" type="int"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="annual_service_cost"
                baseColumnNames="cost_structure_id"
                constraintName="fk_annual_service_cost_structure"
                referencedTableName="cost_structure"
                referencedColumnNames="cost_structure_id"/>
    </changeSet>

    <!-- ====================== HUMAN RESOURCE ====================== -->
    <changeSet id="2025-03-create-human-resource" author="d.palomino">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="human_resource"/>
